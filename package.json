{
  "name": "streaming-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api": "nest build api",
    "build:payment-worker": "nest build payment-worker",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:api": "nest start api --watch",
    "start:dev:payment-worker": "nest start payment-worker --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod:api": "node dist/apps/api/main",
    "start:prod:payment-worker": "node dist/apps/payment-worker/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:api:unit": "jest --config apps/api/test/jest-unit.js",
    "test:libs:unit": "jest --config libs/jest.config.js",
    "test:api:integration": "NODE_ENV=test docker compose -f compose.test.yaml --profile integration up -d --wait && jest --config apps/api/test/jest-integration.js --runInBand && docker compose -f compose.test.yaml --profile integration down -v",
    "test:api:e2e": "docker compose -f compose.test.yaml --profile e2e up --build -d --wait && jest --config apps/api/test/jest-e2e.js --runInBand && docker compose -f compose.test.yaml --profile e2e down -v",
    "test:all": "jest --projects apps/*/test/jest-unit.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "docker:dev": "docker compose -f compose.dev.yaml --env-file .env.development.local up --build",
    "docker:dev:infra": "docker compose -f compose.infra.dev.yaml up -d",
    "docker:prod": "docker compose -f compose.prod.yaml --env-file .env.production.local up --build -d",
    "docker:test": "docker compose -f compose.test.yaml up --build",
    "typeorm": "NODE_ENV=development ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./database/data-source.ts",
    "migration:create": "npx typeorm migration:create",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.70.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "i18n-iso-countries": "^7.14.0",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.4.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "file-type": "^21.3.2"
  }
}
